# Database — replace with your actual PostgreSQL connection string.
# Never commit real credentials. Use your deployment platform's secrets manager.
DATABASE_URL="postgresql://postgres:DostCaraga13@127.0.0.1:5432/tarasense?schema=public"

NEXTAUTH_URL="https://your-domain.com"
QR_PUBLIC_BASE_URL="https://tarasense.dostcaraga.ph"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="TARAsenseisthenewmeta"

# Separate secret for mobile JWT signing. Generate the same way as SESSION_SECRET.
MOBILE_TOKEN_SECRET="TARAsensenumber1"

# Optional: external API base URL (for separate backend deployment).
# Leave empty to use same-origin Next.js routes (/api/*), recommended for single-app deployment.
NEXT_PUBLIC_API_URL="/api/v1"

# Optional: enables AI recommendation text in study analysis pages.
# Keep provider keys server-side only. Never expose them as NEXT_PUBLIC_* values.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Optional: OpenRouter support. Obtain keys from https://openrouter.ai/settings/keys.
TARASENSE_AI_PROVIDER=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-3.1-flash-lite"
OPENROUTER_HTTP_REFERER=""
OPENROUTER_APP_TITLE="TARAsense"

# Optional: model overrides. TARASENSE_AI_MODEL applies to both analysis and chat.
TARASENSE_AI_MODEL=""
TARASENSE_AI_ANALYSIS_MODEL=""
TARASENSE_AI_CHAT_MODEL=""

# Legacy chatbot model override (defaults to gpt-4o-mini when no provider model is set)
OPENAI_CHAT_MODEL=""

# Optional: set to "1" to enable live chatbot responses (requires a server-side AI provider key)
TARASENSE_CHATBOT_LIVE=""

# Optional runtime settings
NODE_ENV="production"
PORT="3000"

# Reminder job protection — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters required.
CRON_SECRET="replace-with-long-random-secret"
REMINDER_TIMEZONE="Asia/Manila"
