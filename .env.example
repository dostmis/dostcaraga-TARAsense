# Database — replace with your actual PostgreSQL connection string.
# Never commit real credentials. Use your deployment platform's secrets manager.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/tarasense?schema=public"

# Public base URL of this app. Used to build the Google OAuth callback URL.
# In development this is typically http://localhost:3000
NEXTAUTH_URL="https://your-domain.com"
QR_PUBLIC_BASE_URL="https://tarasense.dostcaraga.ph"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: at least 32 characters. The app refuses to start in production if
# this is missing, too short, or left as a placeholder.
SESSION_SECRET=""

# --- Google Sign-In (OAuth 2.0) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"). Leave blank to hide/disable the
# "Continue with Google" button gracefully.
#
# Register these Authorized redirect URIs in the Google Cloud Console, matching
# your NEXTAUTH_URL base (path is always /api/auth/google/callback):
#   http://localhost:3000/api/auth/google/callback
#   https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Gmail SMTP) ---
# Used to send the confirmation magic link when a NEW user signs up with Google.
# Requires a Gmail account with 2-Step Verification enabled, then create a
# 16-character App Password at https://myaccount.google.com/apppasswords
# (the value may be shown with spaces; they are ignored). Leave blank to disable
# email confirmation (new Google sign-ups will then be blocked with a notice).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Separate secret for mobile JWT signing. Generate the same way as SESSION_SECRET.
# REQUIRED: at least 32 characters (enforced at boot in production).
MOBILE_TOKEN_SECRET=""

# Optional: external API base URL (for separate backend deployment).
# Leave empty to use same-origin Next.js routes (/api/*), recommended for single-app deployment.
NEXT_PUBLIC_API_URL="/api/v1"

# Optional: enables AI recommendation text in study analysis pages.
# Keep provider keys server-side only. Never expose them as NEXT_PUBLIC_* values.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Optional: OpenRouter support. Obtain keys from https://openrouter.ai/settings/keys.
TARASENSE_AI_PROVIDER=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-3.1-flash-lite"
OPENROUTER_HTTP_REFERER=""
OPENROUTER_APP_TITLE="TARAsense"

# Optional: model overrides. TARASENSE_AI_MODEL applies to both analysis and chat.
TARASENSE_AI_MODEL=""
TARASENSE_AI_ANALYSIS_MODEL=""
TARASENSE_AI_CHAT_MODEL=""

# Legacy chatbot model override (defaults to gpt-4o-mini when no provider model is set)
OPENAI_CHAT_MODEL=""

# Optional: set to "1" to enable live chatbot responses (requires a server-side AI provider key)
TARASENSE_CHATBOT_LIVE=""

# Optional runtime settings
NODE_ENV="production"
PORT="3000"

# Reminder job protection — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters required.
CRON_SECRET="replace-with-long-random-secret"
REMINDER_TIMEZONE="Asia/Manila"

# Optional: extra hosts (comma-separated host[:port], no scheme) allowed to
# invoke Server Actions, in addition to same-origin. Set to your production
# domain(s) when serving behind a proxy/CDN with a different forwarded host.
SERVER_ACTION_ALLOWED_ORIGINS=""
