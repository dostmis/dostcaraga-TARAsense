# Database — replace with your actual PostgreSQL connection string.
# Never commit real credentials. Use your deployment platform's secrets manager.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tarasense?schema=public"

NEXTAUTH_URL="https://your-domain.com"
QR_PUBLIC_BASE_URL="https://tarasense.dostcaraga.ph"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-at-least-32-random-hex-characters"

# Separate secret for mobile JWT signing. Generate the same way as SESSION_SECRET.
MOBILE_TOKEN_SECRET="replace-with-at-least-32-random-hex-characters"

# Optional: external API base URL (for separate backend deployment).
# Leave empty to use same-origin Next.js routes (/api/*), recommended for single-app deployment.
NEXT_PUBLIC_API_URL=""

# Optional: enables AI recommendation text in study analysis pages.
# Obtain from https://platform.openai.com — never commit real keys.
OPENAI_API_KEY=""

# Optional: chatbot model override (defaults to gpt-4o-mini)
OPENAI_CHAT_MODEL=""

# Optional: set to "1" to enable live chatbot responses (requires OPENAI_API_KEY)
TARASENSE_CHATBOT_LIVE=""

# Optional runtime settings
NODE_ENV="production"
PORT="3000"

# Reminder job protection — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters required.
CRON_SECRET="replace-with-long-random-secret"
REMINDER_TIMEZONE="Asia/Manila"
