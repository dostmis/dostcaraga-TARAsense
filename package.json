{
  "name": "tarasense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "npm run build:web",
    "prebuild:web": "prisma generate",
    "build:web": "next build",
    "build:api": "npm --prefix api run build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:stats",
    "test:stats": "tsc --target es2020 --module nodenext --moduleResolution nodenext --esModuleInterop --strict --outDir tests/dist src/lib/services/statistics.ts && node --test tests/statistics.test.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:sync": "prisma db push --accept-data-loss && prisma generate",
    "db:seed:psgc": "tsx prisma/seed-psgc.ts",
    "db:build:psgc": "tsx prisma/seed-data/build-psgc-json.ts",
    "db:rebuild:psgc": "tsx prisma/rebuild-psgc.ts",
    "db:backfill:schedule-ends": "tsx prisma/backfill-schedule-ends.ts",
    "db:backfill:imported-liking": "tsx prisma/backfill-imported-liking.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "openai": "^6.27.0",
    "postcss": "^8.5.8",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5"
  }
}
