generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String?
  name                  String
  role                  UserRole               @default(CONSUMER)
  organization          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assignedRegion        String?
  assignedFacility      String?
  assignmentUpdatedAt   DateTime?
  assignmentUpdatedById String?
  deviceTokens          DeviceToken[]
  ficAssignmentHistory  FicAssignmentHistory[]
  ficAvailability       FicAvailability[]
  notifications         Notification[]
  panelistProfile       Panelist?
  reviewedRequests      RoleUpgradeRequest[]   @relation("RequestReviewer")
  roleRequests          RoleUpgradeRequest[]   @relation("RequestApplicant")
  studies               Study[]
  usageLogs             UserUsageLog[]
  profile               UserProfile?

  @@index([role])
  @@index([role, organization])
  @@index([role, assignedRegion, assignedFacility])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

model RoleUpgradeRequest {
  id         String        @id @default(cuid())
  userId     String
  targetRole UserRole
  status     RequestStatus @default(PENDING)
  reason     String?
  adminId    String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  reviewedBy User?         @relation("RequestReviewer", fields: [adminId], references: [id])
  user       User          @relation("RequestApplicant", fields: [userId], references: [id])

  @@index([status, targetRole])
  @@index([userId, status])
  @@index([createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  level     NotificationLevel    @default(INFO)
  category  NotificationCategory @default(SYSTEM)
  actionUrl String?
  metadata  Json?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([userId, isRead, createdAt])
}

model UserUsageLog {
  id          String    @id @default(cuid())
  actorUserId String?
  actorName   String?
  actorEmail  String?
  actorRole   UserRole?
  action      String
  entityType  String?
  entityId    String?
  summary     String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Panelist {
  id                 String              @id @default(cuid())
  userId             String?             @unique
  name               String
  email              String              @unique
  phone              String?
  age                Int
  gender             Gender
  location           String
  occupation         String?
  lifestyle          String[]
  dietaryPrefs       DietaryPref[]
  consumptionHabits  Json
  isActive           Boolean             @default(true)
  joinedAt           DateTime            @default(now())
  lastActive         DateTime            @updatedAt
  isGuest            Boolean             @default(false)
  organization       String?
  foodConsumption    String[]
  healthFitness      String[]
  workDailyLiving    String[]
  user               User?               @relation(fields: [userId], references: [id])
  screeningResponses ScreeningResponse[]
  participations     StudyParticipant[]

  @@index([age, gender])
  @@index([isActive])
  @@index([isGuest])
}

model Study {
  id                 String                 @id @default(cuid())
  creatorId          String
  title              String
  productName        String
  category           ProductCategory
  stage              StudyStage
  description        String?
  targetDemographics Json
  screeningCriteria  Json
  stratificationVar  String?
  sampleSize         Int
  location           String
  status             StudyStatus            @default(DRAFT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  studyDesign        StudyDesign            @default(WITHIN_SUBJECT)
  screeningResponses ScreeningResponse[]
  sensoryAttributes  SensoryAttribute[]
  responses          SensoryResponse[]
  responseDrafts     SensoryResponseDraft[]
  creator            User                   @relation(fields: [creatorId], references: [id])
  analysis           StudyAnalysis?
  participants       StudyParticipant[]
  attributes         CoreAttribute[]
  derivedMetrics     DerivedMetric[]
  questionResponses  QuestionResponse[]
  sensoryQuestions   SensoryQuestion[]
  locationTarget     StudyLocationTarget?

  @@index([status, creatorId])
  @@index([creatorId, createdAt])
  @@index([status, createdAt])
  @@index([location, status])
}

model ScreeningResponse {
  id          String   @id @default(cuid())
  panelistId  String
  studyId     String
  responses   Json
  isQualified Boolean
  score       Int?
  createdAt   DateTime @default(now())
  panelist    Panelist @relation(fields: [panelistId], references: [id])
  study       Study    @relation(fields: [studyId], references: [id])

  @@unique([panelistId, studyId])
}

model StudyParticipant {
  id                 String                @id @default(cuid())
  studyId            String
  panelistId         String
  status             ParticipantStatus     @default(SELECTED)
  stratum            String?
  selectionOrder     Int
  panelistNumber     Int?
  randomizeCode      String?
  sampleCodes        Json?
  offeredSessions    Json?
  applicationAt      DateTime?
  requestedSessionAt DateTime?
  consentStatus      ConsentStatus         @default(PENDING)
  invitationSent     DateTime?
  confirmedAt        DateTime?
  consentedAt        DateTime?
  declinedAt         DateTime?
  sessionAt          DateTime?
  reminderSentAt     DateTime?
  completedAt        DateTime?
  noShow             Boolean               @default(false)
  guestCode          String?
  source             ParticipationSource   @default(REGISTERED_CONSUMER)
  responses          SensoryResponse[]
  responseDraft      SensoryResponseDraft?
  panelist           Panelist              @relation(fields: [panelistId], references: [id])
  study              Study                 @relation(fields: [studyId], references: [id])

  @@unique([studyId, panelistId])
  @@unique([studyId, guestCode])
  @@unique([studyId, panelistNumber])
  @@index([studyId, panelistNumber])
  @@index([studyId, randomizeCode])
  @@index([studyId, status])
  @@index([studyId, source])
  @@index([studyId, selectionOrder])
  @@index([studyId, requestedSessionAt])
  @@index([studyId, sessionAt])
  @@index([studyId, status, requestedSessionAt])
  @@index([studyId, status, sessionAt])
  @@index([panelistId, status])
}

model SensoryAttribute {
  id                  String   @id @default(cuid())
  studyId             String
  name                String
  type                AttrType
  order               Int
  jarOptions          Json?
  attributeType       String?
  isCustom            Boolean  @default(false)
  sourceAttributeName String?
  study               Study    @relation(fields: [studyId], references: [id])
}

model SensoryResponse {
  id            String           @id @default(cuid())
  studyId       String
  participantId String
  data          Json
  submittedAt   DateTime         @default(now())
  participant   StudyParticipant @relation(fields: [participantId], references: [id])
  study         Study            @relation(fields: [studyId], references: [id])

  @@unique([studyId, participantId])
  @@index([studyId, submittedAt])
  @@index([participantId, submittedAt])
}

model SensoryResponseDraft {
  id            String           @id @default(cuid())
  studyId       String
  participantId String           @unique
  data          Json
  version       Int              @default(1)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  participant   StudyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  study         Study            @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@index([participantId])
  @@index([updatedAt])
}

model StudyAnalysis {
  id               String        @id @default(cuid())
  studyId          String        @unique
  overallLiking    Json
  attributeStats   Json
  penaltyAnalysis  Json
  aiInterpretation String?
  aiRecommendation String?
  decisionFlag     DecisionType?
  generatedAt      DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  study            Study         @relation(fields: [studyId], references: [id])
}

model CoreAttribute {
  id            String            @id @default(cuid()) @map("attribute_id")
  studyId       String            @map("test_id")
  attributeName String            @map("attribute_name")
  category      String            @default("SENSORY")
  attributeType String            @map("attribute_type")
  isCustom      Boolean           @default(false) @map("is_custom")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  study         Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  metrics       DerivedMetric[]
  questions     SensoryQuestion[]

  @@index([studyId])
  @@index([studyId, attributeType])
  @@map("attributes")
}

model SensoryQuestion {
  id           String              @id @default(cuid()) @map("question_id")
  studyId      String              @map("test_id")
  attributeId  String?             @map("attribute_id")
  questionText String              @map("question_text")
  questionType SensoryQuestionType @map("question_type")
  scaleType    SensoryScaleType    @map("scale_type")
  order        Int                 @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  responses    QuestionResponse[]
  attribute    CoreAttribute?      @relation(fields: [attributeId], references: [id])
  study        Study               @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId, order])
  @@map("sensory_questions")
}

model QuestionResponse {
  id           String          @id @default(cuid()) @map("response_id")
  studyId      String          @map("test_id")
  respondentId String          @map("respondent_id")
  questionId   String          @map("question_id")
  rawValue     Float           @map("raw_value")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  question     SensoryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  study        Study           @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId, respondentId])
  @@index([questionId])
  @@map("responses")
}

model DerivedMetric {
  id          String            @id @default(cuid()) @map("metric_id")
  studyId     String            @map("test_id")
  attributeId String?           @map("attribute_id")
  metricType  DerivedMetricType @map("metric_type")
  value       Json
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  attribute   CoreAttribute?    @relation(fields: [attributeId], references: [id])
  study       Study             @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId, metricType])
  @@map("derived_metrics")
}

model FicAvailability {
  id          String    @id @default(cuid())
  ficUserId   String
  date        String
  isAvailable Boolean   @default(false)
  isLocked    Boolean   @default(false)
  lockedById  String?
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ficUser     User      @relation(fields: [ficUserId], references: [id], onDelete: Cascade)

  @@unique([ficUserId, date])
  @@index([ficUserId, date])
  @@index([date, isAvailable, isLocked])
  @@index([ficUserId, isAvailable, isLocked, date])
}

model PsgcRegion {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  shortName    String?
  provinces    PsgcProvince[]
  studyTargets StudyLocationTarget[]
  userProfiles UserProfile[]

  @@index([name])
  @@map("psgc_regions")
}

model PsgcProvince {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  regionId     String
  cities       PsgcCity[]
  region       PsgcRegion            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  studyTargets StudyLocationTarget[]
  userProfiles UserProfile[]

  @@index([regionId, name])
  @@map("psgc_provinces")
}

model PsgcCity {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  isCity       Boolean               @default(false)
  provinceId   String
  barangays    PsgcBarangay[]
  province     PsgcProvince          @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  studyTargets StudyLocationTarget[]
  userProfiles UserProfile[]

  @@index([provinceId, name])
  @@map("psgc_cities")
}

model PsgcBarangay {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  cityId       String
  city         PsgcCity              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  studyTargets StudyLocationTarget[]
  userProfiles UserProfile[]

  @@index([cityId, name])
  @@map("psgc_barangays")
}

model UserProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  regionId       String?
  provinceId     String?
  cityId         String?
  barangayId     String?
  addressDetails String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  barangay       PsgcBarangay? @relation(fields: [barangayId], references: [id])
  city           PsgcCity?     @relation(fields: [cityId], references: [id])
  province       PsgcProvince? @relation(fields: [provinceId], references: [id])
  region         PsgcRegion?   @relation(fields: [regionId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([regionId])
  @@index([provinceId])
  @@index([cityId])
  @@index([barangayId])
  @@map("user_profiles")
}

model StudyLocationTarget {
  id                     String           @id @default(cuid())
  studyId                String           @unique
  scope                  StudyTargetScope @default(CITY)
  regionId               String?
  provinceId             String?
  cityId                 String?
  barangayId             String?
  venueName              String?
  addressDetails         String?
  inheritedFromFicUserId String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  barangay               PsgcBarangay?    @relation(fields: [barangayId], references: [id])
  city                   PsgcCity?        @relation(fields: [cityId], references: [id])
  province               PsgcProvince?    @relation(fields: [provinceId], references: [id])
  region                 PsgcRegion?      @relation(fields: [regionId], references: [id])
  study                  Study            @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([scope, regionId, provinceId, cityId, barangayId])
  @@map("study_location_targets")
}

model FicAssignmentHistory {
  id               String   @id @default(cuid())
  ficUserId        String
  changedById      String?
  previousRegion   String?
  previousFacility String?
  assignedRegion   String
  assignedFacility String
  createdAt        DateTime @default(now())
  ficUser          User     @relation(fields: [ficUserId], references: [id], onDelete: Cascade)

  @@index([ficUserId, createdAt])
  @@index([changedById, createdAt])
}

enum UserRole {
  ADMIN
  MSME
  FIC
  CONSUMER
  RESEARCHER
  FIC_MANAGER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationCategory {
  AUTH
  STUDY
  ROLE
  SURVEY
  SYSTEM
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_SAY
}

enum DietaryPref {
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  HALAL
  KOSHER
  NO_SPECIFIC_DIET
  PLANT_BASED
  FLEXITARIAN
  KETO
  LOW_SUGAR
  HALAL_CONSCIOUS
}

enum ProductCategory {
  BEVERAGE
  SNACK
  DESSERT
  FUNCTIONAL_FOOD
  DAIRY
  BAKERY
}

enum StudyStage {
  PROTOTYPE_CHECK
  REFINEMENT
  MARKET_READINESS
}

enum StudyStatus {
  DRAFT
  RECRUITING
  ACTIVE
  ANALYZING
  COMPLETED
  ARCHIVED
}

enum StudyDesign {
  MONADIC
  WITHIN_SUBJECT
}

enum ParticipationSource {
  REGISTERED_CONSUMER
  WALK_IN_GUEST
}

enum ParticipantStatus {
  SELECTED
  WAITLIST
  CONFIRMED
  COMPLETED
  CANCELLED
  DECLINED
}

enum ConsentStatus {
  PENDING
  AGREED
  DECLINED
}

enum AttrType {
  OVERALL_LIKING
  ATTRIBUTE_LIKING
  JAR
  OPEN_ENDED
}

enum DecisionType {
  NEEDS_IMPROVEMENT
  CONTINUE_REFINEMENT
  READY_FOR_READINESS
  READY_FOR_COMMERCIALIZATION
}

enum SensoryQuestionType {
  HEDONIC
  JAR
  OPEN_ENDED
}

enum SensoryScaleType {
  NINE_PT
  JAR_5PT
  TEXT
}

enum DerivedMetricType {
  MEAN_LIKING
  JAR_FREQ
  PENALTY
}

enum StudyTargetScope {
  ALL
  REGION
  PROVINCE
  CITY
  BARANGAY
}
